# =============================================================================
# Ollama Ultimate Stack — environment template
# Copied to .env on first install if .env is missing.
# 8GB cannot run 24B. 16GB RAM no GPU: 7B ok, 14B risky, 24B crash.
# Devstral 24B really wants ~32GB RAM or a 4090-class GPU.
# Prefer: run check-hardware first, then install (do not overwrite a custom .env).
# =============================================================================

OLLAMA_PORT=11434
WEBUI_PORT=3000
WEBUI_AUTH=false
ENABLE_SIGNUP=false
WEBUI_SECRET_KEY=change-me-in-env-file
WATCHTOWER_POLL_INTERVAL=3600

# 16GB default
RAM_GB=16
PRIMARY_MODEL=devstral:24b
RESEARCH_MODEL=deepseek-r1:14b
FALLBACK_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=12G
OLLAMA_MEMORY_RESERVATION=2G
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
