# =============================================================================
# Ollama Ultimate Stack — fallback template
# You usually do NOT copy this by hand.
# Run check-hardware, then install.cmd / install.sh — that writes .env
# for THIS machine (8GB / 16GB / 32GB) and downloads the matching models.
# =============================================================================

OLLAMA_PORT=11434
WEBUI_PORT=3000
WEBUI_AUTH=false
ENABLE_SIGNUP=false
WEBUI_SECRET_KEY=change-me-in-env-file
WATCHTOWER_POLL_INTERVAL=3600

# Safe laptop defaults if someone runs compose before the installer.
# Capable machines get larger well-known models from check-hardware.
RAM_GB=8
PRIMARY_MODEL=qwen2.5-coder:7b
RESEARCH_MODEL=deepseek-r1:8b
FALLBACK_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_MEMORY_RESERVATION=1G
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
RAG_TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
