# =============================================================================
# Ollama Ultimate Stack — environment
# Default: 16GB RAM profile. Uncomment a different block OR copy a file from
# profiles/ (8gb.env, 16gb.env, 32gb.env) over this file, then: make update
# =============================================================================

# --- Ports ---
OLLAMA_PORT=11434
WEBUI_PORT=3000

# --- Auth (local appliance: no login wall) ---
WEBUI_AUTH=false
ENABLE_SIGNUP=false
WEBUI_SECRET_KEY=change-me-in-env-file

# --- Watchtower (optional auto image updates) ---
# Set to auto-update on shipped clients. Lab can use 120 seconds.
# COMPOSE_PROFILES=auto-update
WATCHTOWER_POLL_INTERVAL=3600

# =============================================================================
# 16GB RAM (DEFAULT) — uncommented
# =============================================================================
RAM_GB=16
PRIMARY_MODEL=devstral:24b
RESEARCH_MODEL=deepseek-r1:14b
FALLBACK_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=12G
OLLAMA_MEMORY_RESERVATION=2G
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# =============================================================================
# 8GB RAM — copy profiles/8gb.env over this file if you have ~8GB
# =============================================================================
# RAM_GB=8
# PRIMARY_MODEL=qwen2.5-coder:7b
# RESEARCH_MODEL=deepseek-r1:8b
# FALLBACK_MODEL=qwen2.5-coder:7b
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_MEMORY_LIMIT=6G
# OLLAMA_MEMORY_RESERVATION=1G
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_FLASH_ATTENTION=0
# RAG_TOP_K=3
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# =============================================================================
# 32GB RAM — copy profiles/32gb.env over this file if you have 32GB+
# =============================================================================
# RAM_GB=32
# PRIMARY_MODEL=qwen3-coder:30b
# RESEARCH_MODEL=deepseek-r1:32b
# FALLBACK_MODEL=qwen2.5-coder:7b
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_MEMORY_LIMIT=24G
# OLLAMA_MEMORY_RESERVATION=4G
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_FLASH_ATTENTION=1
# RAG_TOP_K=8
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150
