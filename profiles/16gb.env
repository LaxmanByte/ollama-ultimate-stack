# Hardware profile: 16GB RAM (default)
# Honest: 16GB + Docker, no NVIDIA -> 3B fast, 7B ok, 14B slow, 24B crash.
# check-hardware still upgrades PRIMARY if VRAM is enough for 24B.
RAM_GB=16
PRIMARY_MODEL=qwen2.5-coder:7b
RESEARCH_MODEL=deepseek-r1:8b
FALLBACK_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_MEMORY_RESERVATION=1G
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
WATCHTOWER_POLL_INTERVAL=3600
