# Hardware profile: 16GB RAM (default)
# Honest: 16GB no GPU → 7B ok, 14B risky, 24B crash.
# check-hardware overrides PRIMARY to 7B unless VRAM is enough for 24B.
RAM_GB=16
PRIMARY_MODEL=devstral:24b
RESEARCH_MODEL=deepseek-r1:14b
FALLBACK_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MEMORY_LIMIT=12G
OLLAMA_MEMORY_RESERVATION=2G
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_FLASH_ATTENTION=0
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
WATCHTOWER_POLL_INTERVAL=3600
